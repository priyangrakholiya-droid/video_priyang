    {
      "id": "opening",
      "title": "Opening",
      "mood": "calm",
      "keywords": [
        "opening",
        "intro",
        "start"
      ],
      "required": false
    },
    {
      "id": "main",
      "title": "Main action",
      "mood": "happy",
      "keywords": [
        "main",
        "action"
      ],
      "required": false
    },
    {
      "id": "people",
      "title": "People",
      "mood": "happy",
      "keywords": [
        "people",
        "face",
        "group"
      ],
      "required": false
    },
    {
      "id": "detail",
      "title": "Details",
      "mood": "calm",
      "keywords": [
        "detail",
        "close",
        "object"
      ],
      "required": false
    },
    {
      "id": "closing",
      "title": "Closing",
      "mood": "emotional",
      "keywords": [
        "closing",
        "end",
        "outro"
      ],
      "required": false
    }
  ],
  "emotion_arc": [
    "calm",
    "happy",
    "fun",
    "romantic",
    "ritual",
    "emotional"
